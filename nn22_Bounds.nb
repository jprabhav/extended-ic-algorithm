  RowBox[{"(*", 
   RowBox[{"1.", " ", "Shannon", " ", "Entropy"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"entropy", "[", "probs_List", "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "===", "0"}], "||", 
           RowBox[{"#", "===", "0."}]}], ",", "0", ",", 
          RowBox[{
           RowBox[{"-", "#"}], " ", 
           RowBox[{"Log", "[", 
            RowBox[{"2", ",", "#"}], "]"}]}]}], "]"}], "&"}], ",", 
       RowBox[{"Flatten", "[", "probs", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", 
    RowBox[{"Alice", "'"}], "s", " ", "input", " ", "function", " ", "f", 
    RowBox[{"(", "a", ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"faGen", "[", "v_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "v", "]"}]}], ",", 
        RowBox[{"i", "=", 
         RowBox[{"v", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"sub", "=", 
         RowBox[{"v", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;"}], "]"}], "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "-", 
       RowBox[{"Total", "[", 
        RowBox[{"FoldList", "[", 
         RowBox[{"Times", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"i", "+", "sub"}], ",", "2"}], "]"}]}], "]"}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"k", ":", 
    RowBox[{
    "number", " ", "of", " ", "variables", " ", "to", " ", "keep", " ", 
     RowBox[{"(", 
      RowBox[{"including", " ", "g"}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getH", "[", 
     RowBox[{"n_", ",", "ec_", ",", "eps_", ",", "b_", ",", "k_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fullJoint", ",", "marginal"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Create", " ", "flat", " ", "joint", " ", "distribution", " ", "of", 
        " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}]}], " ", "elements"}], "*)"}], 
      RowBox[{
       RowBox[{"fullJoint", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"pBase", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"Total", "[", "c", "]"}], ",", "2"}], "]"}]}], 
                   " ", "eps"}]}], ")"}], "/", 
                RowBox[{"2", "^", "n"}]}]}], "}"}], ",", 
             RowBox[{"pBase", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "g"}], ",", "2"}], 
                    "]"}]}], " ", "ec", " ", 
                  RowBox[{"e", "[", 
                   RowBox[{
                    RowBox[{"faGen", "[", "c", "]"}], ",", "b"}], "]"}]}]}], 
                ")"}], "/", "2"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"g", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", 
             RowBox[{"Tuples", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "}"}]}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
