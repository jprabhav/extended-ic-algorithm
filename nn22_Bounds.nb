         RowBox[{"we", " ", "partition", " ", "into", " ", 
          RowBox[{"2", "^", "k"}], " ", "buckets"}]}], "*)"}], 
       RowBox[{"marginal", "=", 
        RowBox[{"Total", "/@", 
         RowBox[{"Partition", "[", 
          RowBox[{"fullJoint", ",", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "+", "1", "-", "k"}], ")"}]}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"entropy", "[", "marginal", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "computing", " ", "entroipes"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"calculateChainInfo", "[", 
    RowBox[{"n_Integer", ",", "ec_", ",", "eps_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kVal", "=", "k"}], ",", "Hac", ",", "Hbc", ",", "Habc", ",",
          "Hc"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "We", " ", "use", " ", "the", " ", "entropy", " ", "identity", " ", 
         "for", " ", "I", 
         RowBox[{"(", 
          RowBox[{"g", ";", " ", 
           RowBox[{"x_k", "|", 
            RowBox[{
             RowBox[{
              RowBox[{"x_", "0"}], "..."}], "x_", 
             RowBox[{"{", 
              RowBox[{"k", "-", "1"}], "}"}]}]}]}], ")"}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"g", " ", "is", " ", "the", " ", "external", " ", "bit"}], 
         ";", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"x_", "0"}], "..."}], "x_", 
          RowBox[{"{", 
           RowBox[{"k", "-", "1"}], "}"}], " ", "is", " ", "history"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Hac", "=", 
         RowBox[{"getH", "[", 
          RowBox[{"n", ",", "ec", ",", "eps", ",", "kVal", ",", 
           RowBox[{"kVal", "+", "1"}]}], "]"}]}], 
        RowBox[{"(*", 
         RowBox[{"H", 
          RowBox[{"(", 
           RowBox[{"g", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x_", "0"}], "..."}], "x_", 
             RowBox[{"{", 
              RowBox[{"k", "-", "1"}], "}"}]}]}], ")"}]}], "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Habc", "=", 
         RowBox[{"getH", "[", 
          RowBox[{"n", ",", "ec", ",", "eps", ",", "kVal", ",", 
           RowBox[{"kVal", "+", "2"}]}], "]"}]}], 
        RowBox[{"(*", 
         RowBox[{"H", 
          RowBox[{"(", 
           RowBox[{"g", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x_", "0"}], "..."}], "x_k"}]}], ")"}]}], "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Note", ":", 
          RowBox[{"H", 
           RowBox[{"(", 
            RowBox[{"history", ",", "x_k"}], ")"}], " ", "and", " ", "H", 
           RowBox[{"(", "history", ")"}], " ", "are", " ", "independent", " ",
            "of", " ", 
           RowBox[{"g", ".", "They"}], " ", "come", " ", "from", " ", "the", 
           " ", "pBase", " ", 
           RowBox[{"distribution", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Hbc", "=", 
         RowBox[{"entropy", "[", 
          RowBox[{"Total", "/@", 
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
