Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PNL", "[", 
    RowBox[{"a_", ",", "b_", ",", "x_", ",", "y_"}], "]"}], "[", 
   RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"a", "+", "b"}], ",", "d"}], "]"}], "==", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", " ", "y"}], "+", 
        RowBox[{"i", " ", "x"}], " ", "+", 
        RowBox[{"j", " ", "y"}], "+", "k"}], ",", "d"}], "]"}]}], ",", 
    RowBox[{"1", "/", "d"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PL", "[", 
    RowBox[{"a_", ",", "b_", ",", "x_", ",", "y_"}], "]"}], "[", 
   RowBox[{"i_", ",", "j_", ",", "k_", ",", "l_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "==", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"i", " ", "x"}], " ", "+", "j"}], ",", "d"}], "]"}]}], "&&",
       " ", 
      RowBox[{"b", "==", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"k", " ", "y"}], "+", "l"}], ",", "d"}], "]"}]}]}], ")"}], 
    ",", "1", ",", "0"}], "]"}]}]}], "Input",
