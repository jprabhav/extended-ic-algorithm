Cell[TextData[{
 StyleBox["OBSERVATIONS\n\n",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox["Notation: NS|L|L",
  FontWeight->"Bold"],
 "\n000| 0r0r\[CloseCurlyQuote]|1r0r\[CloseCurlyQuote]| This one gives a nice \
inequality, but the QM line is trivial\n000| 0r0r\[CloseCurlyQuote]|2r0r\
\[CloseCurlyQuote]| This one gives the best inequality so far, but the QM \
line is trivial\n000| 0r0r\[CloseCurlyQuote]|1r1r\[CloseCurlyQuote] |This one \
gives a not so nice inequality, but the QM line is trivial\n\n",
 StyleBox["Notation: NS|L|WN",
  FontWeight->"Bold"],
 "\n000| 0r0r\[CloseCurlyQuote]|WN| Has a nontrivial QM line, but the \
inequality is always weaker\n000| 0r1r\[CloseCurlyQuote]|WN| Has a nontrivial \
QM line, but the inequality is always weaker\n000| 1r1r\[CloseCurlyQuote]|WN| \
Has a nontrivial QM line, the inequality is tight too, but lamer\n\n000| 1r0r\
\[CloseCurlyQuote]|WN| Has a nontrivial QM line, the inequality is tight too, \
but only with an intersection so to speak\n000| 2r0r\[CloseCurlyQuote]|WN| \
Has a nontrivial QM line, the inequality is tight too, but only with an \
intersection so to speak, but better ^^^^^^^^^\n000| \
2r2r\[CloseCurlyQuote]|WN| Has a nontrivial QM line, the inequality is tight \
too, but only with an intersection so to speak, but worse"
}], "Text",
